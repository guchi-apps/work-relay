# アプリ実行時に参照する環境変数（値は空。ローカル開発の記入例は .env.local.example を参照）

# MariaDB接続。本番は DB_* から scripts/construct-database-url.sh が組み立てる
DATABASE_URL=

# 稼働しているコミットのSHA。deploy.yml が github.sha を書く（シークレットではない）。
# /api/app-version が返し、デプロイのヘルスチェックが照合する（#302）。ローカルでは空でよい
APP_COMMIT_SHA=

# Supabase Auth（他アプリと共有のSupabaseプロジェクト）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 利用を許可するGoogleアカウント（カンマ区切り）。未設定の場合は全員ログイン不可
ALLOWED_GOOGLE_EMAILS=

# GUIの無いホスト・CIから認証の背後にある画面へ入るための開発/CI専用バイパス。
# NODE_ENV=production では常にこの導線ごと無効になる。本番の.envには設定しない
CI_LOGIN_BYPASS_SECRET=

# デプロイ時のみ使用（DATABASE_URL の組み立て元。scripts/construct-database-url.sh）
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# CI/デプロイ通知
SIGNALY_WEBHOOK_URL=

# リリース通知（別チャンネル。未設定ならCI/デプロイと同じチャンネルへ送る）
SIGNALY_RELEASE_WEBHOOK_URL=

# 日次収集の異常通知（Discord。GitHub Actionsのみで使う）
DISCORD_ALERT_WEBHOOK_URL=

# 週次収集API。GitHub Actions等から `Authorization: Bearer` で送る。
COLLECTION_CRON_SECRET=

# サーバー間連携API（/api/internal/*）のBearerトークン。AIDEから週報を登録するときに使う。
# 同じ値をAIDE側の AIDE_RESEARCH_DESK_TOKEN へ設定する（片方だけ変えると連携が止まる）。
INTERNAL_API_KEY=

# 日次収集で新しく入った候補ができたことをaide-botへ知らせる（#41）。3つとも未設定なら通知は
# 送らず、収集自体はそのまま成功で返す。同一VPS上のaide-bot（3103）へlocalhostで届くため、
# AIDE_BOT_URLは外部公開URLではなく http://127.0.0.1:3103 を使う。
# 読み方はguchi-apps/aideの readAideBotConfig() に揃える。AIDE_BOT_TOKENはaide-bot側の
# NOTICE_INGEST_TOKENと同じ値（1Passwordで値を複製せず、提供側の参照をそのまま使う）。
AIDE_BOT_URL=
AIDE_BOT_TOKEN=
AIDE_BOT_EMAIL=

# 画像を社用メールに送る機能（#64）。ZIP化した画像をAIDEの内部APIへ転送する送信先・
# トークン。AIDE_IMAGE_MAIL_URLはAIDEのベースURL（例: https://aide.gucchii.com）を入れる。
# パス（/api/image-mail/send）はAIDE_BOT_URLと同じ流儀でコード側が足すため、ここにパスは
# 含めない（#102）。未設定の場合、画面から送信しようとすると503を返す（AIDE側の実装・設定と
# あわせてIssueで別途起票）。同じ値をAIDE側の環境変数へ設定する（片方だけ変えると連携が止まる）。
AIDE_IMAGE_MAIL_URL=
AIDE_IMAGE_MAIL_TOKEN=

# 業界ニュースを週報メールとして社用メールに送る機能（#110）。選んだ記事から組み立てた
# 件名・HTML本文・テキスト本文をAIDEの内部APIへ渡す送信先・トークン。AIDE_NEWS_MAIL_URLは
# AIDEのベースURL（例: https://aide.gucchii.com）で、パス（/api/news-mail/send）はコード側が
# 足すためここには含めない（画像メールと同じ流儀）。トークンは画像メールと別の値にする
# （片方を失効させてももう片方が止まらないようにするため）。未設定の場合、画面から送信
# しようとすると503を返す。同じ値をAIDE側の環境変数へ設定する。
AIDE_NEWS_MAIL_URL=
AIDE_NEWS_MAIL_TOKEN=

# 共有された文章（メモ等）を社用メールに送る機能（#149）。件名・HTML本文・テキスト本文を
# AIDEの内部APIへ渡す送信先・トークン。AIDE_TEXT_MAIL_URLはAIDEのベースURL（例:
# https://aide.gucchii.com）で、パス（/api/text-mail/send）はコード側が足すためここには
# 含めない（画像・週報メールと同じ流儀）。未設定の場合、画面から送信しようとすると503を
# 返す。AIDE側の受け口はこのIssueでは未実装のため、当面は503のまま（同じ値をAIDE側の
# 環境変数へ設定する）。
AIDE_TEXT_MAIL_URL=
AIDE_TEXT_MAIL_TOKEN=

# issue-deckの共有トークンAPI（#255）。INTERNAL_API_KEY・OPS_API_TOKEN・AIDE_BOT_TOKEN・
# AIDE_IMAGE_MAIL_TOKEN・AIDE_NEWS_MAIL_TOKENは、この2つが揃っていれば共有トークンから実行時に
# 取得し、取得できないときだけ上の環境変数へフォールバックする。ISSUE_DECK_URLはissue-deckの
# ベースURL（organization variableのAPP_BASE_URL）、SHARED_TOKEN_API_SECRETはissue-deck側と同じ値。
# 未設定でもフォールバックで動くため、設定漏れは issue-deck の設定画面の「利用元」で確かめる。
ISSUE_DECK_URL=
SHARED_TOKEN_API_SECRET=

# 記事AI解析（#79・#86）のポーラー（scripts/codex-analysis-worker.mjs。VPS上でPM2が
# 常駐させる）が /api/internal/analysis/claim・/report を呼ぶときのBearerトークン。
# AIDE用の INTERNAL_API_KEY とは別の値にする（呼び出し元が別の主体で、片方の失効で
# もう片方を止めないため）。未設定の場合、ポーラー向けの2つのAPIは503を返し、ポーラーは
# 待機したまま何もしない。ポーラーはアプリと同じこの .env を自分で読む。
ANALYSIS_WORKER_SECRET=

# ops-dashboardが GET /api/internal/ai-usage（AI使用量の集計。#243）を呼ぶときのBearerトークン。
# ops-dashboard側の OPS_API_TOKEN と同じ値にする。未設定の場合このAPIは503を返す。
OPS_API_TOKEN=

# iPhoneのショートカット（docs/share-shortcut.md）が写真を POST /api/share/inbox へ送るときの
# Bearerトークン（#144）。未設定の場合、ショートカットからの送信は503になる（ブラウザ・
# Androidの共有メニューからの送信はログインのセッションで通るため影響しない）。
SHARE_SHORTCUT_TOKEN=

# 新着記事のPush通知（#231）のVAPID鍵。生成: npx web-push generate-vapid-keys
# VAPID_SUBJECTは連絡先（`mailto:<メールアドレス>` かアプリのURL）。3つ揃っていないときは通知機能ごと
# 無効になり、日次収集は通常どおり成功する。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ポーラーの任意設定（未設定でよい。既定値のまま動く）。
# RESEARCH_DESK_URL は未設定なら http://127.0.0.1:<PORT> ——同じホストのアプリを直接叩く。
# RESEARCH_DESK_URL=
# ANALYSIS_WORKER_HOST=
# ANALYSIS_POLL_INTERVAL_SECONDS=60
# ANALYSIS_MAX_JOBS=1
# ANALYSIS_JOB_TIMEOUT_SECONDS=600
# CODEX_BIN=codex
# CODEX_MODEL=
