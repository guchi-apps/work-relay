// Clip は汎用クリップの配線確認用モデルとして残し、業界情報は専用モデルで管理する。

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Clip {
  id          String   @id @default(cuid())
  title       String
  url         String?  @db.Text
  content     String?  @db.Text
  source      String?
  collectedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("clips")
}

enum IndustryBusiness {
  DELIVERY
  LOCKER
}

enum IndustryInformationType {
  NEW_PRODUCT
  COMPETITOR
  INTRODUCTION_CASE
  RECRUITMENT_PARTNERSHIP
  POLICY_SUBSIDY
  MARKET_STATISTICS
  USER_ISSUE
  CONSTRUCTION
  QUALITY_SAFETY
  PATENT
  ACADEMIC_RESEARCH
  VIDEO
  SOCIAL_TREND
  OVERSEAS_CASE
  OTHER
}

enum IndustryImportance {
  HIGH
  MEDIUM
  REFERENCE
}

enum CollectionRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model CollectionRun {
  id                         String                @id @default(cuid())
  startedAt                  DateTime              @default(now())
  finishedAt                 DateTime?
  targetFrom                 DateTime
  targetTo                   DateTime
  supplementalFrom           DateTime?
  status                     CollectionRunStatus   @default(RUNNING)
  fetchedCount               Int                   @default(0)
  selectedCount              Int                   @default(0)
  insertedCount              Int                   @default(0)
  duplicateCount             Int                   @default(0)
  mergedCount                Int                   @default(0)
  excludedCount              Int                   @default(0)
  failedCount                Int                   @default(0)
  errors                     Json?
  excludedArticles           Json?
  industryInformation        IndustryInformation[] @relation("IndustryInformationCollectionRun")
  updatedIndustryInformation IndustryInformation[] @relation("IndustryInformationUpdatedByRun")

  @@index([startedAt])
  @@map("collection_runs")
}

enum IndustryPeriodScope {
  IN_SCOPE
  PAST_30_DAYS_SUPPLEMENT
}

model IndustryInformation {
  id               String                  @id @default(cuid())
  business         IndustryBusiness
  informationType  IndustryInformationType
  title            String
  originalUrl      String                  @db.Text
  normalizedUrl    String                  @unique @db.VarChar(512)
  urlHash          String                  @unique @db.Char(64)
  sourceName       String
  publisher        String?
  isPrimarySource  Boolean                 @default(false)
  publishedAt      DateTime?
  occurredAt       DateTime?
  collectedAt      DateTime                @default(now())
  content          String?                 @db.Text
  summary          String?                 @db.Text
  extractedMetrics Json?
  implications     String?                 @db.Text
  importance       IndustryImportance      @default(REFERENCE)
  targetCompany    String?
  targetProduct    String?
  region           String?
  keywords         Json?
  tags             Json?
  periodScope      IndustryPeriodScope     @default(IN_SCOPE)
  collectionRunId  String?
  collectionRun    CollectionRun?          @relation("IndustryInformationCollectionRun", fields: [collectionRunId], references: [id], onDelete: SetNull)
  mergedSources    Json?
  updateReason     String?                 @db.Text
  updatedByRunId   String?
  updatedByRun     CollectionRun?          @relation("IndustryInformationUpdatedByRun", fields: [updatedByRunId], references: [id], onDelete: SetNull)
  // canonicalId/canonical/relatedReprintsは#43以降は書き込まない（過去データ互換のため列のみ残す）。
  // 転載の統合はmergedSources／updateReason／updatedByRunIdで表現する（docs/architecture.md参照）。
  canonicalId      String?
  canonical        IndustryInformation?    @relation("IndustryInformationCanonical", fields: [canonicalId], references: [id], onDelete: SetNull)
  relatedReprints  IndustryInformation[]   @relation("IndustryInformationCanonical")
  // --- AI解析（#79） -----------------------------------------------------------------
  // `analysisStatus`・`analyzedAt`は最新ジョブの状態を写した非正規化列。絞り込みをPrismaの
  // `where`で行うため（週あたり10件でもJS側で絞ると週送り・件数表示がズレる）、ジョブの状態を
  // 変える処理はすべて`src/lib/article-analysis.ts`の同一トランザクション内でここも更新する。
  analysisStatus   AnalysisJobStatus?
  analyzedAt       DateTime?
  // 人が確定した内容。AIの生成内容は`ArticleAnalysis`側に残り、ここは上書きしない
  // （`business`・`importance`は人が確定したときだけ書き換わり、`reviewedAt`がその印になる）。
  weeklyCandidate  Boolean                 @default(true)
  reviewedAt       DateTime?
  reviewedBy       String?
  reviewNote       String?                 @db.Text
  analysisJobs     ArticleAnalysisJob[]
  analyses         ArticleAnalysis[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([business, informationType])
  @@index([importance, publishedAt])
  @@index([periodScope, publishedAt])
  @@index([collectionRunId])
  @@index([updatedByRunId])
  @@index([canonicalId])
  @@index([analysisStatus])
  @@index([weeklyCandidate])
  @@map("industry_information")
}

// --- 記事のAI解析（#79） ---------------------------------------------------------------
// 解析役はVPS上のCodex CLI（ChatGPTアカウント認証）。Research Deskはジョブを積むだけで、
// 常駐ポーラーが`POST /api/internal/analysis/claim`で取得し、`.../report`で結果を返す。

enum AnalysisJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  AUTH_REQUIRED
}

/// 失敗の理由。画面で「再実行すれば直るのか」「人が先に何かする必要があるのか」を出し分ける。
enum AnalysisFailureKind {
  AUTH_REQUIRED
  RATE_LIMITED
  INVALID_OUTPUT
  EXECUTION_FAILED
  TIMEOUT
}

/// AIが判定した関連性。`OUT_OF_SCOPE`は芸能・スポーツ等のノイズ記事。
enum AnalysisRelevance {
  DELIVERY
  LOCKER
  OUT_OF_SCOPE
}

model ArticleAnalysisJob {
  id             String               @id @default(cuid())
  articleId      String
  article        IndustryInformation  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  // 同一記事の二重実行を防ぐ鍵。`QUEUED`・`RUNNING`の間だけ`articleId`が入り、終了時にnullへ戻す。
  // MySQLのUNIQUEはNULLの重複を許すため、これだけで「実行中は1本」をDBで保証できる。
  activeKey      String?              @unique
  status         AnalysisJobStatus    @default(QUEUED)
  attempt        Int                  @default(1)
  requestedBy    String?
  queuedAt       DateTime             @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  // ポーラーが取得した時点で入れる期限。過ぎたジョブは落ちたものとみなして再度取得できる。
  leaseExpiresAt DateTime?
  workerHost     String?
  failureKind    AnalysisFailureKind?
  failureMessage String?              @db.Text
  analysis       ArticleAnalysis?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, queuedAt])
  @@index([articleId, queuedAt])
  @@map("article_analysis_jobs")
}

model ArticleAnalysis {
  id              String              @id @default(cuid())
  articleId       String
  article         IndustryInformation @relation(fields: [articleId], references: [id], onDelete: Cascade)
  jobId           String              @unique
  job             ArticleAnalysisJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  relevance       AnalysisRelevance
  confidence      Float
  reason          String              @db.Text
  noiseReason     String?             @db.Text
  summary         String              @db.Text
  fullSummary     String?             @db.Text
  announcedOn     DateTime?
  // 項目が増えても移行なしで保持できるようJSONにする（`extractedMetrics`と同じ方針）。
  regions         Json?
  metrics         Json?
  implications    String?             @db.Text
  importance      IndustryImportance  @default(REFERENCE)
  duplicates      Json?
  relatedFindings Json?
  model           String?
  codexAuthMode   String?
  durationMs      Int?
  createdAt       DateTime            @default(now())

  @@index([articleId, createdAt])
  @@map("article_analyses")
}

/// 常駐ポーラーの生存確認。`claim`のたびに更新し、画面の実行環境表示に使う。
/// `codexAuthMode`が`chatgpt`以外（APIキー認証へ切り替わった等）になったら画面で警告する。
model AnalysisWorker {
  host          String   @id
  lastSeenAt    DateTime @default(now())
  codexAuthMode String?
  codexVersion  String?
  lastError     String?  @db.Text
  updatedAt     DateTime @updatedAt

  @@map("analysis_workers")
}

// --- 週報メールの「週の総括」（#110） --------------------------------------------------
// 記事1件ずつの解析（ArticleAnalysisJob）と同じポーラー（scripts/codex-analysis-worker.mjs）が
// 実行するが、対象が記事ではなく「週 × 画面で選んだ記事の集合」なので別テーブルにしてある。
// ArticleAnalysisJob.articleId は NOT NULL で記事側の analysisStatus とも連動しており、
// nullable にして相乗りさせると記事解析側の前提が広く崩れるため。

/// 週の対象記事の拾い方。画面の「対象の取り方」と1対1で対応する。
enum WeeklyBriefBasis {
  PUBLISHED
  COLLECTED
  EITHER
}

model WeeklyBriefJob {
  id             String               @id @default(cuid())
  weekStart      DateTime
  weekEnd        DateTime
  basis          WeeklyBriefBasis     @default(EITHER)
  /// 総括の対象にした記事ID（画面でチェックが入っていたもの）のJSON配列。
  articleIds     Json
  // 同じ週の総括を二重に走らせない鍵。`QUEUED`・`RUNNING`の間だけ週の開始日が入り、
  // 終了時にnullへ戻す（ArticleAnalysisJob.activeKeyと同じ作り）。
  activeKey      String?              @unique
  status         AnalysisJobStatus    @default(QUEUED)
  requestedBy    String?
  queuedAt       DateTime             @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  leaseExpiresAt DateTime?
  workerHost     String?
  failureKind    AnalysisFailureKind?
  failureMessage String?              @db.Text
  // 結果は1ジョブ1件なので、別テーブルにせず同じ行へ持つ。
  headline       String?              @db.Text
  overview       String?              @db.Text
  /// 注目トピック（`{ label, text }`の配列）。項目が増えても移行なしで持てるようJSONにする。
  topics         Json?
  model          String?
  codexAuthMode  String?
  durationMs     Int?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, queuedAt])
  @@index([weekStart, queuedAt])
  @@map("weekly_brief_jobs")
}

// ChatGPT定期タスクの代わりに、Codex CLI（Web検索）で業界ニュースを集める「収集ジョブ」。
// 記事解析・週の総括と同じVPS常駐ポーラーが実行する（src/lib/collection-search.ts）。
// テーブルを分けたのは WeeklyBriefJob と同じ理由（ArticleAnalysisJob は articleId が必須で
// 記事側の analysisStatus と連動するため、相乗りさせると前提が崩れる）。
model CollectionSearchJob {
  id              String               @id @default(cuid())
  // 同時に1本に絞る鍵。`QUEUED`・`RUNNING`の間だけJSTの日付（YYYY-MM-DD）が入り、終了時にnullへ戻す
  // （WeeklyBriefJob.activeKeyと同じ作り）。
  activeKey       String?              @unique
  status          AnalysisJobStatus    @default(QUEUED)
  requestedBy     String?
  queuedAt        DateTime             @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  leaseExpiresAt  DateTime?
  workerHost      String?
  failureKind     AnalysisFailureKind?
  failureMessage  String?              @db.Text
  // 取り込み結果。CollectionRun（AIDE経由の週報登録・RSS収集と同じ実行記録）と件数を突き合わせて
  // 「ChatGPT側とどれだけ重なったか」を見比べられるよう、件数はジョブ側にも写しておく。
  collectionRunId String?
  foundCount      Int?
  droppedCount    Int?
  insertedCount   Int?
  mergedCount     Int?
  duplicateCount  Int?
  excludedCount   Int?
  model           String?
  codexAuthMode   String?
  durationMs      Int?
  searchReport    Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, queuedAt])
  @@map("collection_search_jobs")
}

// 業界ニュース収集でAIが使う検索・判定基準。事業（DELIVERY/LOCKER）ごとに1件ずつ持つ（#211）。
model CollectionSearchPolicy {
  business           IndustryBusiness @id
  policy             String           @db.Text
  pendingInstruction String?          @db.Text
  updatedAt          DateTime         @updatedAt

  @@map("collection_search_policy")
}

// 新着記事のPush通知（#231）の購読。端末（ブラウザ・ホーム画面アプリ）ごとに1行。
// ログインできるのは許可リストの本人だけなので、ユーザーとの紐付けは持たない。
model PushSubscription {
  id        String   @id @default(cuid())
  // Push serviceのURL。同じ端末が再購読すると同じ値になるため、これで一意にする。
  // VarChar(768)は、utf8mb4の一意インデックス上限（3072バイト）に収まる範囲
  endpoint  String   @unique @db.VarChar(768)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// iOSアプリ（#317）のログイン引き継ぎ。ASWebAuthenticationSession と WKWebView はCookieを共有しないため、
// 認証シートで確立したセッションをWebViewへ渡すための、一度限り・短命の記録。
// 認証シート側の /auth/callback が作り、WKWebView側の /auth/native/consume が一度だけ消費する。
model NativeAuthHandoff {
  id            String    @id @default(cuid())
  // 引き継ぎコード（アプリへ返す値）のSHA-256。値そのものは保存しない
  codeHash      String    @unique @db.VarChar(64)
  // 用途。別フローのコードを拒否するため（現状は "login" のみ）
  purpose       String    @db.VarChar(32)
  // アプリが持つ code_verifier のS256のSHA-256。消費時に verifier と突き合わせる
  challengeHash String    @db.VarChar(64)
  // access/refresh token を secret-cipher.ts で暗号化した文字列
  sessionCipher String    @db.Text
  // ログイン後の遷移先（safeNextPath を通した値）
  next          String?   @db.VarChar(512)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
  @@map("native_auth_handoffs")
}
